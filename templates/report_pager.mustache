{{!
    @template tool_mulib/report_pager

    Pager of a system report with the number of records, the content is rendered by JavaScript.
    Must be rendered right after the report, the core paging bar and optionally the download form are hidden.
    Page sizes are JSON encoded.

    Example context (json):
    {
        "reportid": 5,
        "sizes": "[10,25,30,50,100]",
        "filtered": false,
        "download": true,
        "uniqid": "tool_mulib_report_pager123"
    }
}}
<div id="{{uniqid}}" class="tool_mulib-report-pager d-none flex-wrap align-items-center gap-3 mt-3"
    data-report-id="{{reportid}}" data-sizes="{{sizes}}" data-filtered="{{#filtered}}1{{/filtered}}{{^filtered}}0{{/filtered}}"
    data-download="{{#download}}1{{/download}}{{^download}}0{{/download}}"></div>
<script type="module">
import {initPager} from '@moodle/lms/tool_mulib/reportbuilder/pager';
initPager(document.getElementById('{{uniqid}}'));
</script>
