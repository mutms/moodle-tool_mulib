{{!
    @template tool_mulib/expandable_text

    One line of plain text that expands to the full text.

    NOTE: full must be sanitised html, short is plain text!

    Example context (json):
    {
        "expandable": true,
        "guessed": false,
        "short": "Short description",
        "full": "<p>Short description</p><p>and all the other details.</p>"
    }
}}
{{#expandable}}<details class="tool_mulib-expandable-text{{#guessed}} tool_mulib-expandable-text-guessed{{/guessed}}"><summary class="text-truncate"><span>{{short}}</span></summary><div class="tool_mulib-expandable-text-full">{{{full}}}</div></details>{{/expandable}}{{^expandable}}{{{full}}}{{/expandable}}
