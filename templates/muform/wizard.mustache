{{!
    @template tool_mulib/muform/wizard

    Layout of a multi-page form rendered by tool_mulib\muform\wizard::render():
    the stepper above the stage form in a card, horizontal when there is enough space.
    Completed and current steps are active, reachable steps are links, the current one is highlighted,
    later steps are muted.

    Context variables required for this template:
    * title - accessible name of the step list, already cleaned
    * stages - list of steps in order with number, label (already cleaned), is_active, is_current, is_link and url
    * formhtml - rendered stage form

    Example context (json):
    {
        "title": "Steps",
        "stages": [
            {"number": 1, "label": "Source", "is_active": true, "is_current": false, "is_link": true, "url": "https://example.com/import.php?wizard=5&stage=source"},
            {"number": 2, "label": "Columns", "is_active": true, "is_current": true, "is_link": false, "url": "https://example.com/import.php?wizard=5&stage=columns"},
            {"number": 3, "label": "Options", "is_active": false, "is_current": false, "is_link": false, "url": "https://example.com/import.php?wizard=5&stage=options"}
        ],
        "formhtml": "<form>...</form>"
    }
}}
<div class="muform-wizard">
    <nav aria-label="{{title}}" class="muform-wizard-stages mb-4">
        <ol class="muform-stepper">
            {{#stages}}
            <li class="muform-stepper-item{{#is_active}} active{{/is_active}}{{#is_current}} current{{/is_current}}{{^is_current}}{{^is_link}} disabled{{/is_link}}{{/is_current}}"{{#is_current}} aria-current="step"{{/is_current}}>
                <span class="muform-stepper-number" aria-hidden="true">{{number}}</span>
                {{#is_link}}<a class="muform-stepper-label stretched-link" href="{{url}}">{{label}}</a>{{/is_link}}
                {{^is_link}}<span class="muform-stepper-label">{{label}}</span>{{/is_link}}
            </li>
            {{/stages}}
        </ol>
    </nav>
    <div class="muform-wizard-form card">
        <div class="card-body">
            {{{formhtml}}}
        </div>
    </div>
</div>
