{{!
    @template tool_mulib/muform/element/buttons-reversed

    Row of buttons displayed in reversed order, the first button in DOM order is shown last.

    Context variables required for this template:
    * see tool_mulib/muform/element/buttons

    Example context (json):
    {
        "name": "buttons", "type": "buttons", "component": "tool_mulib", "id": "id_buttons",
        "is_hidden": false, "is_disabled": false,
        "elements": [{"name": "submit", "html": "<button>Save</button>"}]
    }
}}
{{< tool_mulib/muform/element/buttons }}
    {{$rowclass}}d-flex flex-wrap flex-row-reverse justify-content-end gap-2{{/rowclass}}
{{/ tool_mulib/muform/element/buttons }}
