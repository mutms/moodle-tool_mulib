{{!
    @template tool_mulib/muform/element/hidden

    Hidden input, errors are rendered as an alert because there is no visible control.

    Context variables required for this template:
    * name - element name
    * type - element type, short class name
    * component - component defining the element
    * id - html id
    * errorid - html id of the error area
    * value - current value
    * has_errors - true if element has errors
    * errors - list of error strings
    * is_disabled - true if initially disabled

    Example context (json):
    {
        "name": "itemid", "type": "text", "component": "tool_mulib", "id": "id_itemid", "errorid": "id_error_itemid", "value": "10",
        "has_errors": false, "errors": [], "is_disabled": false
    }
}}
{{#has_errors}}
<div class="alert alert-danger" role="alert" id="{{errorid}}">
    {{#errors}}<div>{{.}}</div>{{/errors}}
</div>
{{/has_errors}}
<input type="hidden" id="{{id}}" name="{{name}}" value="{{value}}" data-muform-element="{{type}}" data-muform-component="{{component}}" data-muform-name="{{name}}"{{#is_disabled}} disabled data-muform-disabled="1"{{/is_disabled}}>
