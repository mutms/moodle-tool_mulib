{{!
    @template tool_mulib/muform/element/dateinterval

    Date interval element, seven number inputs for years, months, weeks, days, hours, minutes and seconds
    posted as name[unit] with the calendar unit keys y, m, w, d, h, i and s,
    the server builds an ISO 8601 duration string.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * nolabelfor - always true
    * attr_required - true if value is validated as required, the group gets data-muform-required
    * units - list of inputs with unit (y, m, w, d, h, i or s), id, label (already cleaned) and value
    * value - human readable text or "Not set" for frozen elements

    Example context (json):
    {
        "name": "validity", "id": "id_validity", "errorid": "id_error_validity",
        "label": "Validity", "nolabelfor": true, "is_required": false, "attr_required": false,
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "1 year 6 months",
        "units": [
            {"unit": "y", "id": "id_validity_y", "label": "years", "value": "1"},
            {"unit": "m", "id": "id_validity_m", "label": "months", "value": "6"},
            {"unit": "w", "id": "id_validity_w", "label": "weeks", "value": ""},
            {"unit": "d", "id": "id_validity_d", "label": "days", "value": ""},
            {"unit": "h", "id": "id_validity_h", "label": "hours", "value": ""},
            {"unit": "i", "id": "id_validity_i", "label": "minutes", "value": ""},
            {"unit": "s", "id": "id_validity_s", "label": "seconds", "value": ""}
        ]
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}<div class="form-control-plaintext" id="{{id}}">{{value}}</div>{{/is_frozen}}
        {{^is_frozen}}
        <div class="muform-dateinterval d-flex flex-wrap align-items-center column-gap-3 row-gap-2 w-100" role="group" id="{{id}}" aria-labelledby="{{id}}_label" aria-describedby="{{errorid}}"{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#attr_required}} data-muform-required="1"{{/attr_required}}>
            {{#units}}
            <div class="d-flex align-items-center gap-1">
                <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="form-control muform-dateinterval-input{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}[{{unit}}]" value="{{value}}" data-muform-unit="{{unit}}"{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}>
                <label for="{{id}}" class="mb-0">{{label}}</label>
            </div>
            {{/units}}
        </div>
        {{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
