{{!
    @template tool_mulib/muform/element/number

    Number input element, a text input with numeric keyboard hints: number inputs
    change values on mouse wheel scrolling and spinner clicks.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * widthclass - muform-width-small, muform-width-medium, muform-width-full or empty for auto
    * attr_required - true if value is validated as required
    * attributes - list of html attributes with name and value
    * inputmode - numeric for integers, decimal otherwise
    * pattern - format pattern, digits with the allowed decimal places
    * rangeattributes - data-muform-min and data-muform-max attributes with name and value
    * value - current value

    Example context (json):
    {
        "name": "number", "id": "id_number", "errorid": "id_error_number",
        "label": "Label", "is_required": false, "attr_required": false, "attributes": [],
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "42", "inputmode": "numeric", "pattern": "[0-9]+",
        "rangeattributes": [{"name": "data-muform-min", "value": "0"}]
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}<div class="form-control-plaintext" id="{{id}}">{{value}}</div>{{/is_frozen}}
        {{^is_frozen}}<input type="text" inputmode="{{inputmode}}"{{#pattern}} pattern="{{pattern}}"{{/pattern}} autocomplete="off" class="form-control{{#widthclass}} {{widthclass}}{{/widthclass}}{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}" value="{{value}}" aria-describedby="{{errorid}}"{{#rangeattributes}} {{name}}="{{value}}"{{/rangeattributes}}{{#attr_required}} required{{/attr_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}{{#attributes}} {{name}}="{{value}}"{{/attributes}}>{{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
