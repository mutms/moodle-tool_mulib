{{!
    @template tool_mulib/muform/element/editor

    Text editor element, a textarea the site editor attaches to,
    with the text format and the draft item id posted next to it.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * attr_required - true if value is validated as required
    * value - text
    * format - text format constant
    * has_formats - true if the editor supports more formats and a selector is shown
    * formats - list of formats with value, label and selected
    * has_files - true if files are enabled
    * draftitemid - draft item id holding the files
    * rows - textarea rows
    * contenthtml - formatted text, frozen elements only, trusted format_text() output
    * is_unsafe - true if cleaning is disabled, a warning is shown

    Example context (json):
    {
        "name": "description", "id": "id_description", "errorid": "id_error_description",
        "label": "Description", "is_required": false, "attr_required": false, "attributes": [],
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "<p>Hello</p>", "format": 1, "has_formats": false, "formats": [],
        "has_files": true, "draftitemid": "123456", "rows": 10, "contenthtml": "", "is_unsafe": false
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}<div class="form-control-plaintext" id="{{id}}">{{{contenthtml}}}</div>{{/is_frozen}}
        {{^is_frozen}}
        <div class="muform-editor w-100">
            <textarea class="form-control{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}[text]" rows="{{rows}}" aria-describedby="{{errorid}}"{{#attr_required}} required{{/attr_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}>{{value}}</textarea>
            {{#has_formats}}
            <select class="form-select w-auto mt-1" name="{{name}}[format]" aria-label="{{#str}}muform_editorformat, tool_mulib{{/str}}"{{#is_disabled}} disabled{{/is_disabled}}>
                {{#formats}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/formats}}
            </select>
            {{/has_formats}}
            {{^has_formats}}<input type="hidden" name="{{name}}[format]" value="{{format}}"{{#is_disabled}} disabled{{/is_disabled}}>{{/has_formats}}
            {{#has_files}}<input type="hidden" name="{{name}}[itemid]" value="{{draftitemid}}"{{#is_disabled}} disabled{{/is_disabled}}>{{/has_files}}
            {{#is_unsafe}}<div class="form-text text-warning">{{#pix}}i/warning, core{{/pix}} {{#str}}muform_unsafehtml, tool_mulib{{/str}}</div>{{/is_unsafe}}
        </div>
        {{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
