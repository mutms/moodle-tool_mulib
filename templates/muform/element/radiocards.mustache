{{!
    @template tool_mulib/muform/element/radiocards

    Radio buttons rendered as cards with title and optional description.

    Inspired by Bootstrap 6 field group cards, own Bootstrap 5 compatible implementation.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * attr_required - true if value is validated as required
    * nolabelfor - always true
    * value - current value
    * groups - list of option groups with label (may be empty) and options (key, label, description, has_description, is_checked, id)

    Example context (json):
    {
        "name": "radiocards", "id": "id_radiocards", "errorid": "id_error_radiocards",
        "label": "Label", "nolabelfor": true, "is_required": false, "attr_required": false,
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "a", "groups": [{"label": "", "options": [
            {"key": "a", "label": "Option A", "description": "Explanation of A", "has_description": true, "is_checked": true, "id": "id_radiocards_0"},
            {"key": "b", "label": "Option B", "description": "", "has_description": false, "is_checked": false, "id": "id_radiocards_1"}
        ]}]
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        <div role="radiogroup" id="{{id}}" aria-labelledby="{{id}}_label" aria-describedby="{{errorid}}"{{#has_errors}} aria-invalid="true"{{/has_errors}} class="w-100 muform-cards">
            {{#groups}}
            {{#label}}<div class="w-100 fw-bold mt-2">{{label}}</div>{{/label}}
            {{#options}}
            <div class="form-check muform-card">
                <input type="radio" class="form-check-input{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}" value="{{key}}"{{#has_description}} aria-describedby="{{id}}_description"{{/has_description}}{{#is_checked}} checked{{/is_checked}}{{#is_frozen}} disabled{{/is_frozen}}{{#attr_required}} required{{/attr_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}>
                <label class="form-check-label" for="{{id}}">{{label}}</label>
                {{#has_description}}<div class="form-text mt-0" id="{{id}}_description">{{description}}</div>{{/has_description}}
            </div>
            {{/options}}
            {{/groups}}
        </div>
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
