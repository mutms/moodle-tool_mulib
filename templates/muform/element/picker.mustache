{{!
    @template tool_mulib/muform/element/picker

    Picker and pickermany elements, the pills and the button opening the panel are rendered by JavaScript
    from the JSON data attributes, the hidden input holds the submitted comma separated values.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * value - comma separated values
    * is_multiple - true if several values may be picked
    * selected - list of current values with value, label (trusted html) and error
    * has_selected - true if any value is selected
    * selectedjson - JSON of selected
    * panel - panel module name
    * sourcejson - JSON with source class and constructor args
    * stringsjson - localised strings of the panel and the element

    Example context (json):
    {
        "name": "userid", "type": "picker", "component": "tool_mulib", "id": "id_userid",
        "errorid": "id_error_userid", "label": "User", "nolabelfor": true, "is_required": false,
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "5", "is_multiple": false,
        "selected": [{"value": "5", "label": "Jane Doe <strong>jane@example.com</strong>", "error": null}], "has_selected": true,
        "selectedjson": "[{\"value\":\"5\",\"label\":\"Jane Doe <strong>jane@example.com</strong>\",\"error\":null}]",
        "panel": "tool_x/userpicker/panel",
        "sourcejson": "{\"class\":\"tool_x\\\\muform\\\\picker\\\\user\",\"args\":[1]}",
        "stringsjson": "{\"title\":\"Select user\"}"
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}
        <ul class="list-unstyled mb-0" id="{{id}}">
            {{#selected}}<li>{{{label}}}</li>{{/selected}}
            {{^has_selected}}<li class="text-muted">{{#str}}muform_notset, tool_mulib{{/str}}</li>{{/has_selected}}
        </ul>
        {{/is_frozen}}
        {{^is_frozen}}
        <input type="hidden" id="{{id}}" name="{{name}}" value="{{value}}">
        <div class="muform-picker d-flex flex-wrap align-items-center gap-2 w-100{{#has_errors}} is-invalid{{/has_errors}}"
            aria-describedby="{{errorid}}" data-picker-panel="{{panel}}" data-picker-source="{{sourcejson}}"
            data-picker-selected="{{selectedjson}}" data-picker-strings="{{stringsjson}}"{{#is_multiple}} data-picker-multiple="1"{{/is_multiple}}></div>
        {{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
