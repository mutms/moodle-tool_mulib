{{!
    @template tool_mulib/muform/element/datetimerange

    Date and time range element, one text input such as "2026-11-06 11:30 – 12:30"
    in the user's timezone with an optional picker mounted by JavaScript.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * widthclass - muform-width-small, muform-width-medium, muform-width-full or empty for the default range width
    * attr_required - true if value is validated as required
    * attributes - list of html attributes with name and value
    * value - text shown in the input, formatted range or the invalid text typed by user
    * valuehtml - formatted range for frozen elements, with the day offset in superscript
    * start - start timestamp or empty string
    * end - end timestamp or empty string
    * componentsjson - JSON with start year, month, day, hour, minute and second, or empty string
    * endcomponentsjson - JSON with end year, month, day, hour, minute and second, or empty string
    * hint - duration of the current value and end date when it is on another day, already cleaned
    * timezone - IANA timezone name used for the text
    * timezonelabel - localised timezone label, already cleaned, empty when the user is in the site timezone
    * lang - language of the display format
    * pickerstep - minute step of the picker
    * defaulthour - hour of start dates entered without time
    * defaultminute - minute of start dates entered without time
    * defaultduration - seconds added to start entered without end, empty when end is required
    * durationsjson - JSON list of durations offered by the picker, with seconds and label
    * firstday - first day of week in the picker, 0 is Sunday
    * hour12 - true when the display format uses 12 hour clock with AM and PM

    Example context (json):
    {
        "name": "session", "id": "id_session", "errorid": "id_error_session",
        "label": "Session", "is_required": false, "attr_required": false, "attributes": [],
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Invalid date and time range",
        "value": "2026-11-06 23:30 – 01:30 +1", "valuehtml": "2026-11-06 23:30 – 01:30<sup>+1</sup>",
        "start": "1794004200", "end": "1794011400",
        "componentsjson": "{\"year\":2026,\"month\":11,\"day\":6,\"hour\":23,\"minute\":30,\"second\":0}",
        "endcomponentsjson": "{\"year\":2026,\"month\":11,\"day\":7,\"hour\":1,\"minute\":30,\"second\":0}",
        "hint": "2 hours, ends 2026-11-07 01:30",
        "timezone": "Europe/Prague", "timezonelabel": "Time zone: Europe/Prague", "lang": "en",
        "pickerstep": 5, "defaulthour": 0, "defaultminute": 0, "defaultduration": 3600,
        "durationsjson": "[{\"seconds\":3600,\"label\":\"1 hour\"}]", "firstday": 1, "hour12": false
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}<div class="form-control-plaintext" id="{{id}}">{{{valuehtml}}}</div>{{/is_frozen}}
        {{^is_frozen}}
        <div class="muform-datetime muform-datetimerange d-flex align-items-start gap-1 w-100">
            <input type="text" class="form-control {{#widthclass}}{{widthclass}}{{/widthclass}}{{^widthclass}}muform-datetimerange-input{{/widthclass}}{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}" value="{{value}}" aria-describedby="{{errorid}} {{id}}_hint{{#timezonelabel}} {{id}}_timezone{{/timezonelabel}}" autocomplete="off" data-muform-datetimerange-start="{{start}}" data-muform-datetimerange-end="{{end}}" data-muform-datetime-components="{{componentsjson}}" data-muform-datetimerange-endcomponents="{{endcomponentsjson}}" data-muform-datetime-timezone="{{timezone}}" data-muform-datetime-lang="{{lang}}" data-muform-datetime-defaulthour="{{defaulthour}}" data-muform-datetime-defaultminute="{{defaultminute}}" data-muform-datetimerange-defaultduration="{{defaultduration}}"{{#attr_required}} required{{/attr_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}{{#attributes}} {{name}}="{{value}}"{{/attributes}}>
            <span class="muform-datetime-picker" data-muform-datetime-picker data-muform-datetime-step="{{pickerstep}}" data-muform-datetime-firstday="{{firstday}}" data-muform-datetimerange-durations="{{durationsjson}}"{{#hour12}} data-muform-datetime-hour12="1"{{/hour12}}></span>
        </div>
        <div class="form-text text-muted w-100" id="{{id}}_hint" data-muform-datetimerange-hint aria-live="polite">{{hint}}</div>
        {{#timezonelabel}}<div class="form-text text-muted w-100" id="{{id}}_timezone">{{timezonelabel}}</div>{{/timezonelabel}}
        {{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
