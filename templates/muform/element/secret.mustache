{{!
    @template tool_mulib/muform/element/secret

    Secret for machines, the current value is never rendered, only a value typed
    in the submitted request comes back after a reload or validation error.
    The input is a masked text input, never a password input, so browsers
    do not autofill or offer to save it.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * widthclass - muform-width-small, muform-width-medium, muform-width-full or empty for auto
    * attributes - list of html attributes with name and value
    * has_value - true if a current value exists
    * allow_clear - true if the clear checkbox is shown
    * is_cleared - true if the clear checkbox was ticked in the submitted data
    * input_required - true if the input must be filled, false when a current value exists

    Example context (json):
    {
        "name": "secret", "id": "id_secret", "errorid": "id_error_secret",
        "label": "Label", "is_required": false, "attr_required": false, "attributes": [],
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "has_value": true, "allow_clear": true, "is_cleared": false, "input_required": false
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}<div class="form-control-plaintext" id="{{id}}">{{#has_value}}••••••••{{/has_value}}{{^has_value}}{{#str}}muform_notset, tool_mulib{{/str}}{{/has_value}}</div>{{/is_frozen}}
        {{^is_frozen}}
        <div class="muform-secret d-flex align-items-start gap-1 w-100">
            <input type="text" class="form-control muform-secret-masked{{#widthclass}} {{widthclass}}{{/widthclass}}{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}[value]" value="{{value}}" autocomplete="off" spellcheck="false" autocapitalize="off" aria-describedby="{{errorid}}"{{#has_value}} placeholder="••••••••"{{/has_value}}{{#input_required}} required{{/input_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}{{#attributes}} {{name}}="{{value}}"{{/attributes}}>
            <span class="muform-secret-actions" data-muform-secret-actions></span>
        </div>
        {{#allow_clear}}
        <div class="form-check mt-1 w-100">
            <input type="checkbox" class="form-check-input" id="{{id}}_clear" name="{{name}}[clear]" value="1"{{#is_cleared}} checked{{/is_cleared}}{{#is_disabled}} disabled{{/is_disabled}}>
            <label class="form-check-label" for="{{id}}_clear">{{#str}}muform_clearvalue, tool_mulib{{/str}}</label>
        </div>
        {{/allow_clear}}
        {{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
