{{!
    @template tool_mulib/muform/element/select

    Single select dropdown with optional option groups.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * attr_required - true if value is validated as required
    * attributes - list of html attributes with name and value
    * value - current value
    * valuelabel - label of selected option for frozen elements
    * groups - list of option groups with label (may be empty) and options (key, label, is_checked, id)

    Example context (json):
    {
        "name": "select", "id": "id_select", "errorid": "id_error_select",
        "label": "Label", "is_required": false, "attr_required": false, "attributes": [],
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "a", "valuelabel": "Option A",
        "groups": [{"label": "", "options": [{"key": "a", "label": "Option A", "is_checked": true, "id": "id_select_0"}]}]
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{#is_frozen}}<div class="form-control-plaintext" id="{{id}}">{{valuelabel}}</div>{{/is_frozen}}
        {{^is_frozen}}
        <select class="form-select{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}" aria-describedby="{{errorid}}"{{#attr_required}} required{{/attr_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}{{#attributes}} {{name}}="{{value}}"{{/attributes}}>
            {{#groups}}
            {{#label}}<optgroup label="{{label}}">{{/label}}
            {{#options}}
            <option value="{{key}}"{{#is_checked}} selected{{/is_checked}}>{{label}}</option>
            {{/options}}
            {{#label}}</optgroup>{{/label}}
            {{/groups}}
        </select>
        {{/is_frozen}}
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
