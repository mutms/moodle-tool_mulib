{{!
    @template tool_mulib/muform/element/checkbox

    Checkbox element, hidden input makes sure that 0 is always submitted.

    Context variables required for this template:
    * see tool_mulib/muform/element/wrapper
    * attr_required - true if value is validated as required
    * value - current value
    * is_checked - true if checked
    * text - text next to checkbox

    Example context (json):
    {
        "name": "checkbox", "id": "id_checkbox", "errorid": "id_error_checkbox",
        "label": "Label", "is_required": false, "attr_required": false,
        "helpbuttonhtml": "", "is_frozen": false, "is_hidden": false, "is_disabled": false,
        "has_errors": false, "errors": [], "requiredhint": "Required", "invalidhint": "Error",
        "value": "1", "is_checked": true, "text": "Enable feature"
    }
}}
{{< tool_mulib/muform/element/wrapper }}
    {{$control}}
        {{^is_frozen}}<input type="hidden" name="{{name}}" value="0"{{#is_disabled}} disabled{{/is_disabled}}>{{/is_frozen}}
        <div class="form-check">
            <input type="checkbox" class="form-check-input{{#has_errors}} is-invalid{{/has_errors}}" id="{{id}}" name="{{name}}" value="1"{{#is_checked}} checked{{/is_checked}} aria-describedby="{{errorid}}"{{#is_frozen}} disabled{{/is_frozen}}{{#attr_required}} required{{/attr_required}}{{#is_required}} aria-required="true"{{/is_required}}{{#has_errors}} aria-invalid="true"{{/has_errors}}{{#is_disabled}} disabled{{/is_disabled}}>
            {{#text}}<label class="form-check-label" for="{{id}}">{{text}}</label>{{/text}}
        </div>
    {{/control}}
{{/ tool_mulib/muform/element/wrapper }}
